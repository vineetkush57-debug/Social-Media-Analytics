# SIH 2026 Social Media Analytics Configuration

# Backend Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Connection (Default SQLite file fallback: sqlite:///./sih_sma.db)
DATABASE_URL=sqlite:///./sih_sma.db
# PostgreSQL Example: postgresql://sih_user:sih_password@localhost:5432/sih_social_analytics

# AI / ML Settings
AI_SENTIMENT_MODEL=textblob_vader_calibrated
TOPIC_EXTRACTION_MAX_FEATURES=10
DEMO_MODE=true

# Frontend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api
